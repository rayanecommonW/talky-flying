# Copy to .env (gitignored). Local dev works with none of these except ANTHROPIC_API_KEY.

# LLMs
ANTHROPIC_API_KEY=            # radio hosts (Claude)
HOST_MODEL=claude-haiku-5-5
NEBIUS_API_KEY=               # station generation (OpenAI-compatible)
NEBIUS_BASE_URL=
STATION_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Speech: "auto" uses ElevenLabs when a key is set, else the local Kokoro/Whisper server
ELEVENLABS_API_KEY=
SPEECH_PROVIDER=auto
LOCAL_SPEECH_URL=http://localhost:8008/v1

# Voice server
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Service-to-service
INTERNAL_TOKEN=dev-internal-token
MAX_ON_AIR=8

# Production only
DOMAIN=
CORS_ORIGINS=*
