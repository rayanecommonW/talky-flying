{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --filter @dead-air/web...",
  "buildCommand": "pnpm --filter @dead-air/web build",
  "outputDirectory": "apps/web/dist",
  "headers": [
    { "source": "/city/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
