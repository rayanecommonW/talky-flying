{
  "name": "dead-air",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "pnpm --filter @dead-air/web dev",
    "dev:game": "pnpm --filter @dead-air/game dev",
    "dev:livekit": "livekit-server --config infra/livekit.dev.yaml",
    "dev:radio": "cd apps/radio && uv run python -m radio.main dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
