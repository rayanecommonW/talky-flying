{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @dead-air/web...",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/city/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
